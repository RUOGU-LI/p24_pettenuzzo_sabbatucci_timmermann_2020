# This file serves as an example of what your .env file should look like.
# Copy it to a file called ".env" in the project's root directory and replace
# the values with your own. The .env file is ignored by git: never commit it.

# Your WRDS username. The first connection asks for your password and offers
# to store it in ~/.pgpass.
WRDS_USERNAME=jdoe

# Where raw and derived data are stored. Relative paths are relative to the
# project root. The default is _data.
# DATA_DIR=_data

# Where figures, tables and notebooks are written. The default is _output.
# OUTPUT_DIR=_output

# Set to 1 to run the whole pipeline on simulated data, without WRDS.
# Results from simulated data are not replication results.
# USE_SYNTHETIC_DATA=0

# Note: the sample dates (START_DATE, END_DATE) are NOT set here. They are
# committed constants in src/settings.py.
